<Window
    x:Class="HostsFileEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:HostsFileEditor"
    mc:Ignorable="d"
    Title="Hosts File Editor">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="Transparent" MinWidth="300" MinHeight="480">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAcceleratorInvoked"/>
            <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="OnCutAcceleratorInvoked"/>
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAcceleratorInvoked"/>
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAcceleratorInvoked"/>
            <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoAcceleratorInvoked"/>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAcceleratorInvoked"/>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAcceleratorInvoked"/>
        </Grid.KeyboardAccelerators>
        <Grid x:Name="AppTitleBar" Height="42" Padding="0" VerticalAlignment="Top" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="BackButton"
                        Width="38"
                        Height="36"
                        VerticalAlignment="Center"
                        Style="{StaticResource PlainBackButtonStyle}"
                        IsEnabled="{x:Bind IsBackEnabled, Mode=OneWay}"
                        Click="OnBackClick">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="11"/>
                </Button>
                <Image Source="Assets/Square150x150Logo.png"
                       Width="20"
                       Height="20"
                       Stretch="Uniform"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="Hosts File Editor" FontSize="11" FontWeight="Normal" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="TimerStatusButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Padding="8,4,8,4"
                    Background="Transparent"
                    Visibility="{x:Bind TimerStatusVisibility, Mode=OneWay}"
                    Content="{x:Bind TimerStatusText, Mode=OneWay}">
                <Button.Flyout>
                    <MenuFlyout x:Name="TimerStatusFlyout" Placement="BottomEdgeAlignedLeft"/>
                </Button.Flyout>
            </Button>
            <!-- Column 2 = draggable spacer -->
            <!-- Profile indicator — title bar right, before caption buttons -->
            <DropDownButton x:Name="ProfileDropButton" Grid.Column="3"
                            VerticalAlignment="Center" Margin="0,0,8,0" Padding="10,5"
                            Background="Transparent" FontSize="12"
                            ToolTipService.ToolTip="Switch profile">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{x:Bind ProfileDotBrush, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind StatusProfileLabel, Mode=OneWay}"
                                   VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight"/>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
        <MenuBar x:Name="MainMenuBar" Grid.Row="1" Background="Transparent">
            <!-- File -->
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Save" Icon="Save" Click="OnSaveClick" KeyboardAcceleratorTextOverride="Ctrl+S"/>
                <MenuFlyoutItem Text="Save As" Icon="SaveLocal" Click="OnSaveAsClick"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Import Host File" Icon="OpenFile" Click="OnImportClick"/>
                <MenuFlyoutItem Text="Open Text Editor" Click="OnOpenInTextEditorClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Export Profiles…" Click="OnExportProfilesClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A9;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Import Profiles…" Click="OnImportProfilesClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B5;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Restore Default" Click="OnRestoreClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="OnExitClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BB;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <!-- Edit -->
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Refresh" Click="OnRefreshClick" KeyboardAcceleratorTextOverride="F5">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Undo" Icon="Undo" Click="OnUndoClick" KeyboardAcceleratorTextOverride="Ctrl+Z"/>
                <MenuFlyoutItem Text="Redo" Icon="Redo" Click="OnRedoClick" KeyboardAcceleratorTextOverride="Ctrl+Y"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Cut" Icon="Cut" Click="OnCutClick" KeyboardAcceleratorTextOverride="Ctrl+X"/>
                <MenuFlyoutItem Text="Copy" Icon="Copy" Click="OnCopyClick" KeyboardAcceleratorTextOverride="Ctrl+C"/>
                <MenuFlyoutItem Text="Paste" Icon="Paste" Click="OnPasteClick" KeyboardAcceleratorTextOverride="Ctrl+V"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Delete" Icon="Delete" Click="OnDeleteClick"/>
                <MenuFlyoutItem Text="Duplicate" Click="OnDuplicateClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F3;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Move Up" Click="OnMoveUpClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Move Down" Click="OnMoveDownClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Insert Above" Click="OnInsertAboveClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Insert Below" Click="OnInsertBelowClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Enable / Disable" Click="OnCheckClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9A0;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <!-- View -->
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem Text="Hide Comments" IsChecked="{x:Bind IsFilterCommentsHidden, Mode=OneWay}" Click="OnFilterCommentsClick">
                    <ToggleMenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE90A;"/>
                    </ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem Text="Hide Disabled" IsChecked="{x:Bind IsFilterDisabledHidden, Mode=OneWay}" Click="OnFilterDisabledClick">
                    <ToggleMenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE739;"/>
                    </ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutItem Text="Reset Filters" Click="OnResetFiltersClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE894;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Audit Log…" Click="OnAuditLogClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D5;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <!-- Profiles: items built at runtime by RefreshProfileSwitcher() via MenuBarItem swap -->
            <MenuBarItem x:Name="ProfilesMenuBarItem" Title="Profiles"/>
            <!-- Settings -->
            <MenuBarItem Title="Settings">
                <ToggleMenuFlyoutItem Text="Ping IPs" IsChecked="{x:Bind IsPingIPs, Mode=OneWay}" Click="OnPingIPsClick">
                    <ToggleMenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;"/>
                    </ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem Text="Remove Default Text" IsChecked="{x:Bind IsRemoveDefaultText, Mode=OneWay}" Click="OnRemoveDefaultTextClick">
                    <ToggleMenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE75C;"/>
                    </ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <ToggleMenuFlyoutItem Text="Show Diff Before Switching Profiles" IsChecked="{x:Bind IsDiffBeforeSwitchEnabled, Mode=OneWay}" Click="OnDiffBeforeSwitchClick">
                    <ToggleMenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8AB;"/>
                    </ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutSubItem Text="Theme">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE793;"/>
                    </MenuFlyoutSubItem.Icon>
                    <ToggleMenuFlyoutItem x:Name="ThemeSystemItem" Text="System" Click="OnThemeClick" Tag="System"/>
                    <ToggleMenuFlyoutItem x:Name="ThemeLightItem" Text="Light" Click="OnThemeClick" Tag="Light"/>
                    <ToggleMenuFlyoutItem x:Name="ThemeDarkItem" Text="Dark" Click="OnThemeClick" Tag="Dark"/>
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <!-- Help -->
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About" Click="OnAboutClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>
        <Grid x:Name="TopCommandRow" Grid.Row="2" Background="Transparent" Visibility="{x:Bind MainViewVisibility, Mode=OneWay}" ColumnSpacing="4" Padding="8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="600"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="FilterPanel.(Grid.Row)" Value="0"/>
                            <Setter Target="FilterPanel.(Grid.Column)" Value="1"/>
                            <Setter Target="FilterPanel.(Grid.ColumnSpan)" Value="1"/>
                            <Setter Target="FilterPanel.HorizontalAlignment" Value="Right"/>
                            <Setter Target="FilterTextBox.Width" Value="200"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="FilterPanel.(Grid.Row)" Value="1"/>
                            <Setter Target="FilterPanel.(Grid.Column)" Value="0"/>
                            <Setter Target="FilterPanel.(Grid.ColumnSpan)" Value="2"/>
                            <Setter Target="FilterPanel.HorizontalAlignment" Value="Stretch"/>
                            <Setter Target="FilterTextBox.Width" Value="Auto"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <CommandBar Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        DefaultLabelPosition="Collapsed"
                        Padding="0"
                        IsDynamicOverflowEnabled="True">
                <AppBarButton Icon="Save" Label="Save" Click="OnSaveClick"
                              KeyboardAcceleratorTextOverride="Ctrl+S"
                              ToolTipService.ToolTip="Save (Ctrl+S)"/>
                <AppBarButton Icon="Refresh" Label="Refresh" Click="OnRefreshClick"
                              KeyboardAcceleratorTextOverride="F5"
                              ToolTipService.ToolTip="Refresh (F5)"/>
                <AppBarSeparator/>
                <AppBarButton Label="Duplicate" Click="OnDuplicateClick" x:Name="DuplicateButton"
                              ToolTipService.ToolTip="Duplicate">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F3;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Insert Above" Click="OnInsertAboveClick"
                              ToolTipService.ToolTip="Insert Above">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Insert Below" Click="OnInsertBelowClick"
                              ToolTipService.ToolTip="Insert Below">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton Label="Move Up" Click="OnMoveUpClick" x:Name="MoveUpButton"
                              ToolTipService.ToolTip="Move Up">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Move Down" Click="OnMoveDownClick" x:Name="MoveDownButton"
                              ToolTipService.ToolTip="Move Down">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton Icon="Delete" Label="Delete" Click="OnDeleteClick" x:Name="RemoveButton"
                              ToolTipService.ToolTip="Delete"/>
                <AppBarSeparator/>
                <AppBarToggleButton Label="Profiles" IsChecked="{x:Bind IsArchiveVisible, Mode=OneWay}"
                                    Click="OnViewArchiveClick" ToolTipService.ToolTip="Manage Profiles">
                    <AppBarToggleButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8EC;"/>
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
            </CommandBar>
            <!-- Compact filter panel adjusted to avoid clipping -->
            <Grid x:Name="FilterPanel" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilterTextBox"
                             Grid.Column="0"
                             Width="200"
                             PlaceholderText="Filter hosts..."
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             CornerRadius="4,0,0,4"
                             BorderThickness="1,1,0,1"
                             TextChanged="OnFilterTextChanged"
                             GotFocus="OnFilterBoxGotFocus"
                             LostFocus="OnFilterBoxLostFocus"
                             Padding="12,4,12,4"/>
                    <Button x:Name="FilterOptionsButton"
                            Grid.Column="1"
                            Width="40"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource FilterOptionsButtonStyle}"
                            ToolTipService.ToolTip="Filter options">
                        <Grid>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71C;" FontSize="16"/>
                            <InfoBadge x:Name="ActiveFiltersBadge"
                                       Value="{x:Bind ActiveFilterCount, Mode=OneWay}"
                                       Visibility="{x:Bind ActiveFiltersBadgeVisibility, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,-4,-4,0" />
                        </Grid>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <ToggleMenuFlyoutItem Text="Hide Comments"
                                                      IsChecked="{x:Bind IsFilterCommentsHidden, Mode=OneWay}"
                                                      Click="OnFilterCommentsClick">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE90A;"/>
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem Text="Hide Disabled"
                                                      IsChecked="{x:Bind IsFilterDisabledHidden, Mode=OneWay}"
                                                      Click="OnFilterDisabledClick">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE739;"/>
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Reset Filters" Click="OnResetFiltersClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE894;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Background="Transparent">
            <Grid x:Name="MainHost" Margin="8,0,8,8" RowDefinitions="Auto,*" Background="Transparent" Visibility="{x:Bind MainViewVisibility, Mode=OneWay}">
                <InfoBar x:Name="NotificationBar"
                         Grid.Row="0"
                         IsOpen="False"
                         IsClosable="True"
                         Margin="0,4,0,0"/>
                <ListView x:Name="EntriesList"
                          Grid.Row="1"
                          Margin="0,8,0,0"
                          SelectionMode="Extended"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ItemsSource="{x:Bind Entries, Mode=OneWay}"
                          SelectionChanged="OnEntriesSelectionChanged"
                          GotFocus="OnEntriesListGotFocus">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                            <ReorderThemeTransition/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="CtxCopy" Text="Copy" Click="OnCopyClick" Icon="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" />
                            <MenuFlyoutItem x:Name="CtxCut" Text="Cut" Click="OnCutClick" Icon="Cut" KeyboardAcceleratorTextOverride="Ctrl+X" />
                            <MenuFlyoutItem x:Name="CtxPaste" Text="Paste" Click="OnPasteClick" Icon="Paste" KeyboardAcceleratorTextOverride="Ctrl+V" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CtxAddAbove" Text="Add Above" Click="OnInsertAboveClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CtxAddBelow" Text="Add Below" Click="OnInsertBelowClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CtxUndo" Text="Undo" Click="OnUndoClick" Icon="Undo" KeyboardAcceleratorTextOverride="Ctrl+Z" />
                            <MenuFlyoutItem x:Name="CtxRedo" Text="Redo" Click="OnRedoClick" Icon="Redo" KeyboardAcceleratorTextOverride="Ctrl+Y" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <!-- Style override to remove underline/border from TextBoxes within entries list -->
                    <ListView.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:HostsEntry">
                            <!-- Single 4-column layout for all rows. Comment-only rows are de-emphasized:
                                 IP and hostname fields appear dimmed (still editable — typing in them
                                 converts the row to a real entry); the comment field is shown in italic. -->
                            <Border Padding="{x:Bind local:EntryLayoutHelper.GetPadding(HasCommentOnly), Mode=OneWay}"
                                    CornerRadius="4" BorderThickness="0,1,0,1" BorderBrush="#14000000"
                                    HorizontalAlignment="Stretch"
                                    Background="{x:Bind local:HostEntryBrushHelper.Get(Self), Mode=OneWay}">
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="0" Margin="8,0" IsChecked="{x:Bind Enabled, Mode=TwoWay}"/>
                                    <TextBox Grid.Column="1"
                                             local:SharedColumnWidth.ColumnKey="IpAddress"
                                             Text="{x:Bind IpAddress, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Margin="1,0" CornerRadius="4,0,0,4" PlaceholderText="IP address..."
                                             Opacity="{x:Bind local:EntryLayoutHelper.GetFieldOpacity(HasCommentOnly), Mode=OneWay}"/>
                                    <TextBox Grid.Column="2"
                                             local:SharedColumnWidth.ColumnKey="HostNames"
                                             Text="{x:Bind HostNames, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Margin="1,0" CornerRadius="0" PlaceholderText="Host names..."
                                             Opacity="{x:Bind local:EntryLayoutHelper.GetFieldOpacity(HasCommentOnly), Mode=OneWay}"/>
                                    <TextBox Grid.Column="3"
                                             Text="{x:Bind Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="1,0" CornerRadius="0,4,4,0" HorizontalAlignment="Stretch"
                                             PlaceholderText="Comment..."
                                             FontStyle="{x:Bind local:EntryLayoutHelper.GetCommentFontStyle(HasCommentOnly), Mode=OneWay}"
                                             FontWeight="{x:Bind local:EntryLayoutHelper.GetCommentFontWeight(HasCommentOnly), Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Text="No hosts entries yet." FontStyle="Italic" Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="{x:Bind EntriesEmptyVisibility, Mode=OneWay}"/>
                <TextBlock Grid.Row="1" Text="No entries match the current filters." FontStyle="Italic" Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="{x:Bind EntriesFilteredVisibility, Mode=OneWay}"/>
            </Grid>
            <Grid x:Name="ArchiveHost" Visibility="{x:Bind ArchiveViewVisibility, Mode=OneWay}" Margin="8" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="Profiles" FontWeight="Normal" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" Padding="0" HorizontalAlignment="Left">
                        <AppBarButton x:Name="ArchiveLoadButton" Label="Activate" Click="OnArchiveLoadClick" IsEnabled="False">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="ArchiveTimerButton" Label="Activate Temporarily" Click="OnArchiveTimerClick" IsEnabled="False">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB91;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator/>
                        <AppBarButton x:Name="ArchiveCloneButton" Label="Clone" Click="OnArchiveCloneClick" IsEnabled="False">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="ArchiveSettingsButton" Icon="Setting" Label="Settings" Click="OnArchiveSettingsClick" IsEnabled="False"/>
                        <AppBarButton x:Name="ArchiveDeleteButton" Icon="Delete" Label="Delete" Click="OnArchiveDeleteClick" IsEnabled="False"/>
                    </CommandBar>
                </Grid>
                <Grid Grid.Row="1">
                    <ListView x:Name="ArchiveList" Margin="0,8,0,0" Background="Transparent" ItemsSource="{x:Bind Archives, Mode=OneWay}" SelectionChanged="OnArchiveSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:HostsProfile">
                                <Grid ColumnDefinitions="Auto,*" Padding="0,4,0,4">
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{x:Bind local:ProfileBrushHelper.GetColorBrush(Self), Mode=OneWay}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind FileName}"/>
                                        <TextBlock Text="{x:Bind DisplayDescription}" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="No profiles yet." FontStyle="Italic" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="{x:Bind ArchivesEmptyVisibility, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
