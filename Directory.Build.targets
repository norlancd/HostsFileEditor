<Project>
  <!-- Shared signing, packaging, and copy logic executed during Publish (not AfterTargets) so that outputs are tracked. -->
  <PropertyGroup>
    <!-- Default certificate values (can be overridden per invocation) -->
    <CertFile Condition="'$(CertFile)'==''">$(MSBuildThisFileDirectory)HostsFileEditorTestCert.pfx</CertFile>
    <CertPassword Condition="'$(CertPassword)'==''">test</CertPassword>
    <!-- Whether to sign published exe/msix -->
    <EnableSigning>true</EnableSigning>
    <!-- Marker directory for copied publish outputs -->
    <_PackagedOutputStampDir>$(BaseIntermediateOutputPath)packaging\</_PackagedOutputStampDir>
  </PropertyGroup>

  <!-- Ensure AppxManifest.xml is always published for projects that have it -->
  <ItemGroup>
    <None Update="AppxManifest.xml" Condition="Exists('$(ProjectDir)AppxManifest.xml')"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- Inline task: find the newest versioned folder under <KitsRoot10>\bin that has the tool -->
  <UsingTask TaskName="FindLatestSdkTool"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <KitsRoot10 ParameterType="System.String" Required="true" />
      <ToolName   ParameterType="System.String" Required="true" />
      <Result     ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
#pragma warning disable 0162
        Result = string.Empty;

        string bestPath = null;
        Version bestVer = null;

        if (!string.IsNullOrEmpty(KitsRoot10))
        {
            var bin = Path.Combine(KitsRoot10, "bin");
            if (Directory.Exists(bin))
            {
                foreach (var dir in Directory.GetDirectories(bin))
                {
                    var name = Path.GetFileName(dir); // e.g. "10.0.26100.0"
                    if (Version.TryParse(name, out var v))
                    {
                        var candidate = Path.Combine(dir, "x64", ToolName);
                        if (File.Exists(candidate) && (bestVer == null || v > bestVer))
                        {
                            bestVer = v;
                            bestPath = candidate;
                        }
                    }
                }
            }
        }

        Result = bestPath ?? string.Empty;
        return true;
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Inline task: run an external tool as a direct child process (no cmd.exe intermediary).
       signtool/makeappx invoked via MSBuild's <Exec> (which always wraps the command in a temp
       cmd.exe /Q /D /C script) intermittently hung indefinitely at ~0% CPU right when makeappx started -
       every single hang observed involved that cmd.exe hop, and running the exact same tool directly
       (no cmd.exe) was reliable every time. This task runs the process directly via
       System.Diagnostics.Process instead. -->
  <UsingTask TaskName="RunProcess"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FileName ParameterType="System.String" Required="true" />
      <Arguments ParameterType="System.String" Required="false" />
      <WorkingDirectory ParameterType="System.String" Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Diagnostics" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
#pragma warning disable 0162
        var psi = new ProcessStartInfo
        {
            FileName = FileName,
            Arguments = Arguments ?? string.Empty,
            UseShellExecute = false,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            // Redirect stdin and close it immediately below: any tool that tries to prompt (e.g. makeappx
            // asking to overwrite) then gets EOF and errors out fast instead of blocking on input forever.
            RedirectStandardInput = true,
        };
        if (!string.IsNullOrEmpty(WorkingDirectory))
        {
            psi.WorkingDirectory = WorkingDirectory;
        }

        using (var proc = new Process())
        {
            proc.StartInfo = psi;
            proc.OutputDataReceived += (s, e) => { if (e.Data != null) Log.LogMessage(MessageImportance.High, e.Data); };
            proc.ErrorDataReceived += (s, e) => { if (e.Data != null) Log.LogMessage(MessageImportance.High, e.Data); };
            proc.Start();
            proc.StandardInput.Close();
            proc.BeginOutputReadLine();
            proc.BeginErrorReadLine();
            proc.WaitForExit();

            if (proc.ExitCode != 0)
            {
                Log.LogError(FileName + " exited with code " + proc.ExitCode);
                return false;
            }
        }
        return true;
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Resolve tool paths (signtool / makeappx) when not already resolvable via PATH -->
  <Target Name="_ResolvePackagingTools" BeforeTargets="SignAndPackage">

    <!-- Defaults: try PATH first -->
    <PropertyGroup>
      <SignToolExe Condition="'$(SignToolExe)'==''">signtool.exe</SignToolExe>
      <MakeAppxExe Condition="'$(MakeAppxExe)'==''">makeappx.exe</MakeAppxExe>
    </PropertyGroup>

    <!-- Normalize common roots -->
    <PropertyGroup>
      <_WindowsSdkVerBinPathNorm>$([MSBuild]::EnsureTrailingSlash('$(WindowsSdkVerBinPath)'))</_WindowsSdkVerBinPathNorm>
      <_WindowsSdkDirNorm>$([MSBuild]::EnsureTrailingSlash('$(WindowsSdkDir)'))</_WindowsSdkDirNorm>
      <_WindowsSDKVersionNorm>$([MSBuild]::EnsureTrailingSlash('$(WindowsSDKVersion)'))</_WindowsSDKVersionNorm>
      <_TargetPlatformVersionNorm>$([MSBuild]::EnsureTrailingSlash('$(TargetPlatformVersion)'))</_TargetPlatformVersionNorm>
      <!-- Prefer WindowsSDKVersion if present; else TargetPlatformVersion -->
      <_SdkVersionToUse Condition="'$(_SdkVersionToUse)'=='' and '$(_WindowsSDKVersionNorm)'!=''">$(_WindowsSDKVersionNorm)</_SdkVersionToUse>
      <_SdkVersionToUse Condition="'$(_SdkVersionToUse)'=='' and '$(_TargetPlatformVersionNorm)'!=''">$(_TargetPlatformVersionNorm)</_SdkVersionToUse>
    </PropertyGroup>

    <!-- 1) WindowsSdkVerBinPath (already versioned in VS dev shells) -->
    <PropertyGroup Condition="'$(_WindowsSdkVerBinPathNorm)'!=''">
      <SignToolExe Condition="'$(SignToolExe)'=='signtool.exe' and Exists('$(_WindowsSdkVerBinPathNorm)x64\signtool.exe')">$(_WindowsSdkVerBinPathNorm)x64\signtool.exe</SignToolExe>
      <MakeAppxExe Condition="'$(MakeAppxExe)'=='makeappx.exe' and Exists('$(_WindowsSdkVerBinPathNorm)x64\makeappx.exe')">$(_WindowsSdkVerBinPathNorm)x64\makeappx.exe</MakeAppxExe>
    </PropertyGroup>

    <!-- 2) WindowsSdkDir + (WindowsSDKVersion or TargetPlatformVersion) -->
    <PropertyGroup Condition="'$(_WindowsSdkDirNorm)'!='' and '$(_SdkVersionToUse)'!=''">
      <_SdkBinVersionDir>$(_WindowsSdkDirNorm)bin\$(_SdkVersionToUse)</_SdkBinVersionDir>
      <SignToolExe Condition="'$(SignToolExe)'=='signtool.exe' and Exists('$(_SdkBinVersionDir)x64\signtool.exe')">$(_SdkBinVersionDir)x64\signtool.exe</SignToolExe>
      <MakeAppxExe Condition="'$(MakeAppxExe)'=='makeappx.exe' and Exists('$(_SdkBinVersionDir)x64\makeappx.exe')">$(_SdkBinVersionDir)x64\makeappx.exe</MakeAppxExe>
    </PropertyGroup>

    <!-- 3) Registry-derived KitsRoot10 (shell-independent) -->
    <PropertyGroup>
      <_KitsRoot10>$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots','KitsRoot10',''))</_KitsRoot10>
      <_KitsRoot10 Condition="'$(_KitsRoot10)'==''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots','KitsRoot10','', 'Registry32'))</_KitsRoot10>
      <_KitsRoot10 Condition="'$(_KitsRoot10)'==''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots','KitsRoot10','', 'Registry64'))</_KitsRoot10>
      <_KitsRoot10>$([MSBuild]::EnsureTrailingSlash('$(_KitsRoot10)'))</_KitsRoot10>
    </PropertyGroup>

    <!-- 4) KitsRoot10 + version (same version preference as above) -->
    <PropertyGroup Condition="'$(_KitsRoot10)'!='' and '$(_SdkVersionToUse)'!=''">
      <_KitsVerDir>$(_KitsRoot10)bin\$(_SdkVersionToUse)</_KitsVerDir>
      <SignToolExe Condition="'$(SignToolExe)'=='signtool.exe' and Exists('$(_KitsVerDir)x64\signtool.exe')">$(_KitsVerDir)x64\signtool.exe</SignToolExe>
      <MakeAppxExe Condition="'$(MakeAppxExe)'=='makeappx.exe' and Exists('$(_KitsVerDir)x64\makeappx.exe')">$(_KitsVerDir)x64\makeappx.exe</MakeAppxExe>
    </PropertyGroup>

    <!-- 5) Enumerate versioned directories under KitsRoot10\bin and pick the newest (no LINQ) -->
    <FindLatestSdkTool Condition="'$(SignToolExe)'=='signtool.exe' and '$(_KitsRoot10)'!=''"
                       KitsRoot10="$(_KitsRoot10)" ToolName="signtool.exe">
      <Output TaskParameter="Result" PropertyName="_LatestSignTool" />
    </FindLatestSdkTool>

    <FindLatestSdkTool Condition="'$(MakeAppxExe)'=='makeappx.exe' and '$(_KitsRoot10)'!=''"
                       KitsRoot10="$(_KitsRoot10)" ToolName="makeappx.exe">
      <Output TaskParameter="Result" PropertyName="_LatestMakeAppx" />
    </FindLatestSdkTool>

    <PropertyGroup>
      <SignToolExe Condition="'$(SignToolExe)'=='signtool.exe' and '$(_LatestSignTool)'!=''">$(_LatestSignTool)</SignToolExe>
      <MakeAppxExe Condition="'$(MakeAppxExe)'=='makeappx.exe' and '$(_LatestMakeAppx)'!=''">$(_LatestMakeAppx)</MakeAppxExe>
    </PropertyGroup>

    <!-- 6) Last resort: unversioned \bin\x64 under KitsRoot10 -->
    <PropertyGroup Condition="'$(_KitsRoot10)'!=''">
      <SignToolExe Condition="'$(SignToolExe)'=='signtool.exe' and Exists('$(_KitsRoot10)bin\x64\signtool.exe')">$(_KitsRoot10)bin\x64\signtool.exe</SignToolExe>
      <MakeAppxExe Condition="'$(MakeAppxExe)'=='makeappx.exe' and Exists('$(_KitsRoot10)bin\x64\makeappx.exe')">$(_KitsRoot10)bin\x64\makeappx.exe</MakeAppxExe>
    </PropertyGroup>

    <Message Text="Using SignTool: $(SignToolExe)" Importance="Low" />
    <Message Text="Using MakeAppx: $(MakeAppxExe)" Importance="Low" />
  </Target>
 
  <!-- Ensure stamp directory exists -->
  <Target Name="_CreatePackagingStampDir" BeforeTargets="Publish">
    <MakeDir Directories="$(_PackagedOutputStampDir)" Condition="!Exists('$(_PackagedOutputStampDir)')" />
  </Target>

  <!-- Main packaging target now incremental: Inputs/Outputs allow MSBuild to skip when unchanged.
       Outputs points at the stamp file (not the local publish-dir .msix) because Clean only removes the
       stamp; using the .msix as the marker let a stale-but-present publish-dir .msix cause this target
       (including the copy to OutputPackagingDir) to be skipped even right after a Clean emptied artifacts\. -->
  <Target Name="SignAndPackage"
          Condition="'$(SkipMsixPackaging)' != 'true'"
          DependsOnTargets="_ResolvePackagingTools"
          AfterTargets="Publish"
          Inputs="@(ResolvedFileToPublish)"
          Outputs="$(_PackagedOutputStampDir)$(ProjectName).stamp">
    <PropertyGroup>
      <_EffectivePublishDir>$(ProjectDir)$(PublishDir)</_EffectivePublishDir>
      <MsixFile>$(_EffectivePublishDir)$(AssemblyName).msix</MsixFile>
      <PublishZipFile>$(AssemblyName).zip</PublishZipFile>
      <!-- Clean, project-local staging dir we assemble the exact package payload into. -->
      <_MsixStageDir>$(BaseIntermediateOutputPath)msix-stage\</_MsixStageDir>
      <_Now>$([System.DateTime]::UtcNow.ToString("o"))</_Now>
    </PropertyGroup>

    <!-- Assemble the package payload in a clean staging dir instead of packing the live publish dir
         in place. The live publish dir is unreliable as a package source: it accumulates generated
         artifacts across runs (the previous .msix, the -portable exe, the .zip - all of which makeappx
         would otherwise bake into the new .msix), and an incremental `dotnet publish` silently drops the
         Assets\*.png logos (and dll.config) it deems up-to-date, so makeappx then fails manifest
         validation because the declared logos aren't in the package.
         Runtime files are copied from the publish dir - it always has the correct final executable,
         including the single-file-bundled exe (WinForm); @(ResolvedFileToPublish) can't be used for this
         because for single-file publishes it lists the pre-bundle managed dlls, not the bundled exe.
         Generated artifacts and pdbs are excluded. -->
    <RemoveDir Directories="$(_MsixStageDir)" />
    <MakeDir Directories="$(_MsixStageDir)" />
    <ItemGroup>
      <_MsixPayload Include="$(_EffectivePublishDir)**\*.*"
                    Exclude="$(_EffectivePublishDir)**\*.pdb;$(_EffectivePublishDir)**\*.msix;$(_EffectivePublishDir)**\*.zip;$(_EffectivePublishDir)$(AssemblyName)-portable.exe;$(_EffectivePublishDir)AppxManifest.xml;$(_EffectivePublishDir)Assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MsixPayload)"
          DestinationFiles="@(_MsixPayload->'$(_MsixStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />

    <!-- Manifest + Assets are always sourced from the project, since the incremental publish is what
         drops them from the publish dir in the first place. -->
    <Copy SourceFiles="$(ProjectDir)AppxManifest.xml" DestinationFolder="$(_MsixStageDir)" Condition="Exists('$(ProjectDir)AppxManifest.xml')" />
    <ItemGroup>
      <_AssetFiles Include="$(ProjectDir)Assets\**\*.*" />
    </ItemGroup>
    <Copy Condition="'@(_AssetFiles)' != ''"
          SourceFiles="@(_AssetFiles)"
          DestinationFiles="@(_AssetFiles->'$(_MsixStageDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" />

    <!-- Sign EXE (in staging) if enabled and exists -->
    <RunProcess Condition="'$(EnableSigning)'=='true' AND Exists('$(_MsixStageDir)$(AssemblyName).exe')"
                FileName="$(SignToolExe)"
                Arguments="sign /fd SHA256 /f &quot;$(CertFile)&quot; /p &quot;$(CertPassword)&quot; /t http://timestamp.digicert.com &quot;$(_MsixStageDir)$(AssemblyName).exe&quot;" />

    <!-- Create MSIX from the staging dir. /o (overwrite) is mandatory: without it makeappx prompts
         "output file exists, overwrite? (y/n)" whenever the target .msix is already present, and with no
         console stdin it blocks forever - this was the real cause of the packaging "hang". -->
    <RunProcess Condition="Exists('$(_MsixStageDir)')"
                FileName="$(MakeAppxExe)"
                Arguments="pack /o /d &quot;$(_MsixStageDir.TrimEnd('\\'))&quot; /p &quot;$(MsixFile)&quot;" />

    <!-- Sign MSIX -->
    <RunProcess Condition="'$(EnableSigning)'=='true' AND Exists('$(MsixFile)')"
                FileName="$(SignToolExe)"
                Arguments="sign /fd SHA256 /a /f &quot;$(CertFile)&quot; /p &quot;$(CertPassword)&quot; &quot;$(MsixFile)&quot;" />

    <!-- Optionally ZIP (only when CreatePublishZip true), built from the staging dir too.
         Single-file publishes (PublishSingleFile=true, e.g. WinForm) rename the sole exe to a -portable
         suffix so the zip's contents are self-explanatory without the msix/install context, then zip just
         that file. The rename copy happens AFTER makeappx so the -portable exe is never baked into the msix.
         Non-single-file publishes (e.g. WinUI, which ships WebView2/App SDK dlls alongside the exe) must
         keep the exe's original name - an unpackaged WinUI/WinAppSDK app loads its .pri resource file by
         the running exe's own module name, so renaming it makes the app crash on launch with
         STATUS_RESOURCE_DATA_NOT_FOUND. Zip every runtime file (not just the exe) or the app won't have
         what it needs to launch at all. The staging dir has no pdb/msix/zip, so only manifest+assets are
         excluded. The archive is written to the publish dir where the copy-out step below looks for it. -->
    <Copy Condition="'$(CreatePublishZip)'=='true' AND '$(PublishSingleFile)'=='true' AND Exists('$(_MsixStageDir)$(AssemblyName).exe')"
          SourceFiles="$(_MsixStageDir)$(AssemblyName).exe"
          DestinationFiles="$(_MsixStageDir)$(AssemblyName)-portable.exe" />
    <RunProcess Condition="'$(CreatePublishZip)'=='true' AND '$(PublishSingleFile)'=='true'"
                FileName="$(Pkg7ZipCLI)\tools\7za.exe"
                Arguments="a -tzip -aoa &quot;$(_EffectivePublishDir)$(PublishZipFile)&quot; &quot;$(AssemblyName)-portable.exe&quot;"
                WorkingDirectory="$(_MsixStageDir)" />
    <RunProcess Condition="'$(CreatePublishZip)'=='true' AND '$(PublishSingleFile)'!='true'"
                FileName="$(Pkg7ZipCLI)\tools\7za.exe"
                Arguments="a -tzip -aoa &quot;$(_EffectivePublishDir)$(PublishZipFile)&quot; * -x!*.pdb -x!*.msix -x!*.zip -x!AppxManifest.xml -x!Assets"
                WorkingDirectory="$(_MsixStageDir)" />

    <!-- Only the final, standalone deliverables (msix/zip) get copied out - not the loose publish-dir
         files (manifest, assets, raw exe) - so the output directory isn't cluttered with files that look
         like artifacts but aren't runnable/distributable on their own. -->
    <ItemGroup>
      <_PublishedFiles Include="$(MsixFile)" Condition="Exists('$(MsixFile)')" />
      <_PublishedFiles Include="$(_EffectivePublishDir)$(PublishZipFile)" Condition="'$(CreatePublishZip)'=='true' AND Exists('$(_EffectivePublishDir)$(PublishZipFile)')" />
    </ItemGroup>

    <!-- Copy published files into flavor directory if defined -->
    <ItemGroup Condition=" '$(OutputPackagingDir)' != '' ">
      <_CopyPublishedFiles Include="@(_PublishedFiles)" />
    </ItemGroup>
    <Copy Condition=" '@(_CopyPublishedFiles)' != '' " SourceFiles="@(_CopyPublishedFiles)" DestinationFiles="@(_CopyPublishedFiles->'$(OutputPackagingDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <!-- Write stamp file to allow incremental up-to-date check -->
    <WriteLinesToFile File="$(_PackagedOutputStampDir)$(ProjectName).stamp" Lines="SignAndPackage completed $(_Now)" Overwrite="true" />
    <Message Text="Packaged $(ProjectName) to $(OutputPackagingDir) (Files: @(_PublishedFiles->Count()))" Importance="high" />
  </Target>

  <!-- Participate in Clean: remove copied outputs and stamp.
       Uses a bin\**\ wildcard (not $(PublishDir)) because $(PublishDir) doesn't reliably include the
       RID-specific publish subfolder here, which previously left a stale .msix behind after Clean -
       causing SignAndPackage's Inputs/Outputs check to treat the next publish as already up to date. -->
  <Target Name="_CleanSignAndPackage" AfterTargets="Clean">
    <ItemGroup>
      <_StampFiles Include="$(_PackagedOutputStampDir)*.stamp" />
    </ItemGroup>
    <Delete Files="@(_StampFiles)" />
    <ItemGroup>
      <_GeneratedArtifacts Include="$(ProjectDir)bin\**\$(AssemblyName).msix" />
      <_GeneratedArtifacts Include="$(ProjectDir)bin\**\$(AssemblyName).zip" Condition="'$(CreatePublishZip)'=='true'" />
      <_GeneratedArtifacts Include="$(ProjectDir)bin\**\$(AssemblyName)-portable.exe" Condition="'$(CreatePublishZip)'=='true'" />
    </ItemGroup>
    <Delete Files="@(_GeneratedArtifacts)" />
  </Target>
</Project>
